# ============================================================
# CraftLine AI — environment template
# Copy this file to .env and replace every placeholder.
# NEVER commit .env or share its contents.
# ============================================================

# ---------- MongoDB Atlas ----------
# Example: mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
# Atlas requires TLS. Add your current public IP in Atlas > Network Access.
# Temporary "Add Current IP" entries expire; prefer a permanent x.x.x.x/32 entry.
# Never add tlsAllowInvalidCertificates, tlsInsecure, or tlsAllowInvalidHostnames.
# Diagnose with: python -m Backend.scripts.check_db --verbose
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGO_DB_NAME=freelancer_platform
MONGODB_TIMEOUT_MS=5000

# ---------- Application ----------
APP_NAME=CraftLine AI
APP_VERSION=1.0.0
DEBUG=false

# ---------- Authentication (Phase 2) ----------
# Generate a long random value, for example: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=1440

# ---------- Gemini (Phase 6) ----------
# AI Studio may issue either AIza... or AQ.... keys. Both are passed through
# unchanged. The key's Google project must have Gemini API access (free tier
# or billing enabled), otherwise the API returns a safe 503 permission error.
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Use a current model available to the key's project. Retired models return 404.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=60000

# ---------- CORS ----------
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
